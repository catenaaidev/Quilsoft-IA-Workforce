# Solo entorno local; no incluir credenciales reales en Git.
APP_ENV=development
# D1 se configura mediante el binding DB en apps/api/wrangler.jsonc.
# El login central NO se considera integrado hasta validar su contrato JWT/JWKS.
SSO_ISSUER=https://sso.example.invalid
SSO_JWKS_URL=https://sso.example.invalid/.well-known/jwks.json
SSO_AUDIENCE=ia-workforce
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
DOC_PROCESSOR_URL=
DOC_PROCESSOR_TOKEN=

# Loyal: configurar SOLO después de obtener el contrato oficial, permisos de lectura y caso de prueba aprobado.
# LOYAL_LOOKUP_URL_TEMPLATE=https://loyal.example.invalid/api/products/{sku}/technical-sheet
